{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "github": {
    "silent": true
  },
  "trailingSlash": false,
  "redirects": [
    { "source": "/owner-annex-dashboard", "destination": "/", "permanent": false },
    { "source": "/owner-annex-dashboard.html", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/blog", "destination": "/guides/" },
    { "source": "/blog/he/:slug", "destination": "/guides/he/:slug" },
    { "source": "/blog/:slug", "destination": "/guides/:slug" },
    { "source": "/share", "destination": "/api/share" }
  ],
  "functions": {
    "api/og.mjs": { "includeFiles": "lib/fonts/**" },
    "api/share.mjs": { "includeFiles": "share-page.html" },
    "api/live-nudge.mjs": { "maxDuration": 10 }
  },
  "headers": [
    {
      "source": "/public-data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=20, s-maxage=30, stale-while-revalidate=300" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
